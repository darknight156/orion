# Project Orion — Environment Configuration
# Copy this file to .env and adjust values as needed.

# Optional: Provide token via environment or enter interactively at launch
ORION_DISCORD_TOKEN=""

# Discord API Base URL (Official v10 API)
ORION_API_BASE_URL="https://discord.com/api/v10"

# Local SQLite database path
ORION_DATABASE_PATH="orion_state.db"

# Default monitoring poll interval in seconds (minimum 5.0 to respect rate limits)
ORION_REFRESH_INTERVAL_SECONDS=15.0

# Request timeout and retry policy
ORION_REQUEST_TIMEOUT_SECONDS=15.0
ORION_MAX_RETRIES=3

# Demo mode (true allows offline testing with realistic fixtures without network token)
ORION_DEMO_MODE=false
